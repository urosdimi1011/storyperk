# Baza: npm run dev sam podiže lokalni PostgreSQL na portu 5455 (isti URL radi i sa docker compose up -d)
DATABASE_URL=postgres://storyperk:storyperk@localhost:5455/storyperk
# Direktna konekcija za migracije (na Neon-u: URL bez -pooler)
DATABASE_URL_UNPOOLED=postgres://storyperk:storyperk@localhost:5455/storyperk

# Javni URL aplikacije (koristi se u linkovima koje gost dobija u DM-u)
APP_URL=http://localhost:3000

# Tajna za potpisivanje sesije i hesiranje kodova za prijavu (min. 32 karaktera)
SESSION_SECRET=promeni-me-na-dugacak-nasumican-string-od-32-plus

# Email za kod za prijavu (Resend). Bez kljuca, kod se ispisuje u konzoli servera.
RESEND_API_KEY=
EMAIL_FROM=StoryPerk <prijava@storyperk.rs>

# Meta / Instagram (Instagram API with Instagram Login)
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Dozvoljava dev simulaciju story-ja na stranici ponude (samo lokalno!)
ENABLE_DEV_TOOLS=true
